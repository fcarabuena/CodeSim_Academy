# Copy this file to .env and fill in the values. Never commit .env.

# --- Database -------------------------------------------------------------
# Local (docker compose up -d): both URLs can be the same.
# Neon: DATABASE_URL = the *pooled* connection string (host contains "-pooler"),
#       DIRECT_URL   = the direct (non-pooled) string, used only for migrations.
DATABASE_URL="postgresql://codesim:codesim@localhost:5432/codesim"
DIRECT_URL="postgresql://codesim:codesim@localhost:5432/codesim"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# The public URL of the app. Locally http://localhost:3000,
# on Render https://<your-service>.onrender.com
AUTH_URL="http://localhost:3000"

# Optional GitHub login. Leave empty to hide the GitHub button.
# Create an OAuth app at https://github.com/settings/developers with callback
#   <AUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
