{
  "functionName": "celsiusToFahrenheit",
  "tests": [
    { "id": "freezing", "kind": "returns", "name": "0°C is 32°F", "args": [0], "expected": 32 },
    { "id": "boiling", "kind": "returns", "name": "100°C is 212°F", "args": [100], "expected": 212 },
    { "id": "minus-forty", "kind": "returns", "name": "-40°C is -40°F", "args": [-40], "expected": -40, "hint": "Negative numbers work with the same formula." },
    { "id": "body", "kind": "returns", "name": "37°C is 98.6°F", "args": [37], "expected": 98.6, "hint": "Don't round the answer: 37 * 9 / 5 + 32 is 98.6." }
  ]
}
