// CodeSim Academy data model.
// Connection URLs live in prisma.config.ts (CLI, uses DIRECT_URL) and
// src/lib/db.ts (runtime, uses the pooled DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  // Null for OAuth-only accounts.
  passwordHash   String?
  role           Role      @default(STUDENT)
  xp             Int       @default(0)
  level          Int       @default(1)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  // IANA zone name, e.g. "Europe/London". Streaks fall back to UTC when null.
  timezone       String?
  /// Set when an admin disables the account: it can't log in or submit.
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())

  submissions   Submission[]
  progress      LessonProgress[]
  badges        UserBadge[]
  classesTaught Classroom[]       @relation("TeacherClasses")
  memberships   ClassMembership[]
  auditEntries  AuditLog[]
}

model Track {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id         String @id @default(cuid())
  slug       String
  trackId    String
  title      String
  order      Int
  difficulty String
  xpReward   Int

  track       Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  submissions Submission[]
  progress    LessonProgress[]

  @@unique([trackId, slug])
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  code        String
  passed      Boolean
  score       Int
  resultsJson Json
  /**
   * Lesson hints revealed before this submission (reported by the browser).
   */
  hintsUsed   Int      @default(0)
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([lessonId])
}

model LessonProgress {
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  bestScore   Int            @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([completedAt])
}

model Badge {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  description  String
  icon         String
  criteriaJson Json
  users        UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

/// A teacher's class. Students join with `code`.
model Classroom {
  id        String   @id @default(cuid())
  name      String
  /// Short join code shared with students, e.g. "K7Q4MZ".
  code      String   @unique
  teacherId String
  createdAt DateTime @default(now())

  teacher User              @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  members ClassMembership[]

  @@index([teacherId])
}

model ClassMembership {
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

/// Every admin action: who did what to which record, and when.
model AuditLog {
  id          String   @id @default(cuid())
  /// Null if the admin's account was later deleted, or for script actions.
  actorId     String?
  /// Snapshot of who acted (name and masked email), kept even if the account goes.
  actorLabel  String
  /// e.g. "user.role_changed", "class.deleted"
  action      String
  targetType  String
  targetId    String?
  /// Snapshot of the target (masked email or class name).
  targetLabel String
  details     Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
